# ORBIT OS works fully WITHOUT these (deterministic planner + offline snapshots).
# Optional LLM for Quick Investigation planning/narration. The key stays on the dev server
# (Vite middleware at /api/llm); it is never sent to the browser.
ORBIT_LLM_API_KEY=
# Any OpenAI-compatible chat completions endpoint
ORBIT_LLM_BASE_URL=https://api.openai.com/v1
ORBIT_LLM_MODEL=gpt-4o-mini

# ── Data connectors (server-side only; never sent to the browser) ──────────
# Proxied by Vite middleware at /api/connector/*. Fill any you have; the
# Settings → Data connections panel reflects what is configured.
# NASA Earthdata (unlocks Earthdata, ASF granule download, NISAR, HyP3)
ORBIT_EARTHDATA_USER=
ORBIT_EARTHDATA_PASS=
# Copernicus Data Space (Sentinel-1 STAC)
ORBIT_CDSE_CLIENT_ID=
ORBIT_CDSE_CLIENT_SECRET=
# Sentinel Hub Process API
ORBIT_SENTINEL_HUB_TOKEN=
# OpenTopography
ORBIT_OPENTOPOGRAPHY_KEY=
