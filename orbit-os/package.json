    "test": "node scripts/kernel-selftest.mjs",
    "data:live": "node scripts/build-live.mjs",
    "assets": "node scripts/sync-assets.mjs",
    "data:all": "node scripts/build-events.mjs && node scripts/build-live.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "lucide-react": "^1.73.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-globe.gl": "^2.38.0",
    "react-router-dom": "^6.30.6",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "typescript": "5.6",
    "vite": "^6.4.6"
