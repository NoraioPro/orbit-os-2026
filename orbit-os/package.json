{
  "name": "orbit-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ORBIT OS - Space Intelligence Platform (NASA Space Apps 2026). One Change Engine, Many Worlds.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . && vite build",
